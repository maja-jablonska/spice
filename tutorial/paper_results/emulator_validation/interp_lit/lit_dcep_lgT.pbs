#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=09:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-lit-dcep-lgT
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# Fully Luck (2018) delta Cep literature model with the phase-1 bundle: Teff(phase) as well as log g, vmicro, vmacro, [Fe/H], CNO.
# Same command as the v2b run dc_lit_luck_lgT (181905587, litrepro/out/dcep_lit_luck_lgT.pkl), only the bundle differs.
[ -d $P1 ] || { echo "phase-1 bundle missing: $P1"; exit 1; }
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt --bundle $P1 --out $OUTD/dcep_lit_luck_lgT_p1.pkl
