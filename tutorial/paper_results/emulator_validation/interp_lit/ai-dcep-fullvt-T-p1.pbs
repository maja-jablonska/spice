#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=09:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-dcep-fullvt-T-p1
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# delta Cep Luck (2018) literature model with the FULL Luck vmicro curve (no cap any more: the 3.4 km/s --vmicro-cap that kept v2b
# below its t02 -> t05 step). Same command as dc_lit_luck_lg otherwise.
[ -d $P1 ] || { echo "bundle missing: $P1"; exit 1; }
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt --bundle $P1 --out $OUTD/dcep_lit_luck_lgT_fullvt_p1.pkl
