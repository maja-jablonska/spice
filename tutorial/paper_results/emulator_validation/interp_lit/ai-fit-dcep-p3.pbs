#!/bin/bash
#PBS -N ai-fit-dcep-p3
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=28
#PBS -l ngpus=2
#PBS -l mem=180GB
#PBS -l walltime=30:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# delta Cep full fit, phase 3, multi-fidelity: TPayne (exact) outer steps, cheap inner loop = phase-3 basis student (spectra)
# + phase-3 block-PCA (VT photometry). Free: Teff(phase) (Fourier, start Trahin 2021), Vb(phase) (order 4, start Luck),
# [Fe/H], [C/N/O/Fe], p-factor scale. Fixed: vrot 0, E(B-V) 0.092, d 279.5 pc, Luck vmicro(phase) and log g(phase), G23,
# VT only (all via DC_ARGS minus its --fix-teff / --fix-vmacro / --maxiter 0). Smoke first. No PBS commands inside.
export XLA_FLAGS="--xla_gpu_autotune_level=0"   # the k6144 student's basis would otherwise be copied by autotuning
DC_FIT=$(echo "$DC_ARGS" | sed -e "s/--fix-teff //" -e "s/--fix-vmacro //" -e "s/--maxiter 0 //")
for f in "--fix-teff" "--fix-vmacro" "--maxiter 0"; do case "$DC_FIT" in *"$f "*) echo "could not remove $f"; exit 1;; esac; done
BP=/scratch/y89/mj8805/emu_check/arch_study_p3/block_pca; ST=/scratch/mk27/mj8805/aet-distill/runs/basis_fgk_interp_p3_k6144_h2048x5
CONV=/scratch/y89/mj8805/emu_check/arch_study_p3/bp_params_to_npz.py; V2B=/scratch/y89/mj8805/emu_check/arch_study/block_pca/mlp_4x2048
# params.pkl -> weights.npz (the loader format); first prove the converter reproduces the v2b weights.npz bit for bit
$PY -u $CONV $V2B --check $V2B/weights.npz || { echo "CONVERTER CHECK FAIL"; exit 1; }
[ -f $BP/mlp_4x2048/weights.npz ] || $PY -u $CONV $BP/mlp_4x2048 || { echo "phase-3 block-PCA conversion failed"; exit 1; }
MF="--exact-loss --gpus 2 --cheap-block-pca $BP --cheap-model mlp_4x2048 --cheap-student $ST --free-feh --free-cno --free-vscale \
    --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_trahin2021_teff_curve.txt --bundle $P3"
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_FIT $MF --exact-phot-wl 2000 --n-spec-epochs 3 --windows 5160 --n-phases 6 --maxiter 2 \
    --mf-outer 2 --mf-inner 3 --out $OUTD/dcep_fit_p3_smoke.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_FIT $MF --exact-phot-wl 16000 --n-spec-epochs 40 --windows 5160 5380 6100 6400 --maxiter 40 \
    --mf-outer 40 --mf-inner 60 --mf-radius 8 --out $OUTD/dcep_fit_p3_mf.pkl
