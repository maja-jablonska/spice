#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=07:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-lit3-tz-scan
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
[ -d $P3 ] || { echo "phase-3 bundle missing: $P3"; exit 1; }
# Phase 3 (v2 grid: blue CN/CH lines) vs phase 1 and v2b: emulator jump scan + TZ For literature model (Gallenne 2016).
rc=0
$PY -u $SCAN --bundle v2b=$V2B --bundle interp_p1=$P1 --bundle interp_p3=$P3 --out $OUTD/scan_v2b_p1_p3 || rc=1
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_ARGS --out $OUTD/tzfor_lit_exact_p3.pkl --dump-model $OUTD/tzfor_lit_exact_p3.npz || rc=1
exit $rc
