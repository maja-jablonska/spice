#!/bin/bash
#PBS -N tz-geomfit-mesh
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Step 2: SPICE meshes from PHOEBE at its best geometry (geomfit_phoenix.json): Roche, the secondary rotating at
# v sin i / sin i (45.8 km/s, so its Roche flattening is right), spectra meshes at the 21 HARPS epochs (n1500) and
# light-curve meshes at 40 phases per eclipse (n1200). Parameter names and epochs from the existing pickles.
# CPU only; no PBS commands.
set -uo pipefail
export PHOEBE_ENABLE_ONLINE_PASSBANDS=FALSE OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 JAX_PLATFORMS=cpu
export PYTHONPATH=/scratch/y89/mj8805/spice_v2/src
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; G=/scratch/y89/mj8805/litrepro/geomfit; T=/scratch/y89/mj8805/litrepro/tzfor
OLD_SP=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_aemu_roche_n1500_spectra_meshes.pkl; OLD_LC=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_aemu_roche_n1200_lc6650_meshes.pkl
eval $($PY -c "
import json; r=json.load(open('$G/geomfit_phoenix.json')); b=r['best']
print(f'export TZ_FOR_PRIMARY_RADIUS={b[\"R1\"]:.5f} TZ_FOR_SECONDARY_RADIUS={b[\"R2\"]:.5f} TZ_FOR_INCL_DEG={b[\"incl\"]:.5f} TZ_FOR_SECONDARY_VROT_KMS={r[\"vrot\"][1]:.4f} GEOM_DPHI={b[\"dphi\"]:.6f}')")
echo "geometry: R1 $TZ_FOR_PRIMARY_RADIUS R2 $TZ_FOR_SECONDARY_RADIUS i $TZ_FOR_INCL_DEG vrot2 $TZ_FOR_SECONDARY_VROT_KMS dphi $GEOM_DPHI"
[ -n "${TZ_FOR_PRIMARY_RADIUS:-}" ] || { echo "no geometry"; exit 1; }
echo "$GEOM_DPHI" > $G/geomfit_dphi.txt
cd $T
$PY -u tzfor_phoebe_aemu_photometry.py --mode export-spectra --n-mesh 1500 --names-from $OLD_SP --times-from $OLD_SP \
    --meshes $G/tzfor_geomfit_roche_n1500_spectra_meshes.pkl || exit 1
$PY -u tzfor_phoebe_aemu_photometry.py --mode export-lc --n-mesh 1200 --teff2 6350 --n-per-eclipse 40 --n-out 12 --names-from $OLD_LC \
    --meshes $G/tzfor_geomfit_roche_n1200_lc_meshes.pkl || exit 1
ls -la $G/*.pkl
