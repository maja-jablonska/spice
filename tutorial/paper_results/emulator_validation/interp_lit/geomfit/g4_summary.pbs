#!/bin/bash
#PBS -N tz-geomfit-sum
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Step 4: PHOEBE geometry fits + the SPICE literature model on the imported geometry, rescored. CPU; no PBS commands.
set -uo pipefail
G=/scratch/y89/mj8805/litrepro/geomfit; O=/scratch/y89/mj8805/litrepro/interp/out; PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python
CSV=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_lightcurve.csv
{ grep -h "^BEST" $G/geomfit_phoenix.log $G/geomfit_ck2004.log
  for f in $(ls -t /scratch/y89/mj8805/litrepro/geomfit/tz-geomfit-lit.o* 2>/dev/null | head -1); do grep -E "SMOKE|^exact model|dphi" $f; done
  for m in lit vmac; do for n in none out-of-eclipse; do [ -f $O/tzfor_geomfit_p3_$m.npz ] && $PY -u /scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py --dump $O/tzfor_geomfit_p3_$m.npz --csv $CSV --nightly $n; done; done
} > $G/geomfit_summary.txt 2>&1
cat $G/geomfit_summary.txt
