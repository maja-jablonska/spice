#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=07:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-lit-tz-scan
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# After phase 1: emulator jump scan (v2b vs phase-1 interpolated) + TZ For literature model (Gallenne 2016) with the phase-1 bundle.
[ -d $P1 ] || { echo "phase-1 bundle missing: $P1"; exit 1; }
rc=0
$PY -u $SCAN --bundle v2b=$V2B --bundle interp_p1=$P1 --out $OUTD/scan_v2b_vs_p1 || rc=1
SPICE_HARPS_BUNDLE=$P1 $PY -u $TZ_PY $TZ_ARGS --out $OUTD/tzfor_lit_exact_p1.pkl --dump-model $OUTD/tzfor_lit_exact_p1.npz || rc=1
exit $rc
