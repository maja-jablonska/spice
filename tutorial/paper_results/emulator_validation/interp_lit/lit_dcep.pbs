#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=09:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-lit-dcep
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# After phase 1: delta Cep literature model (Luck 2018 vmicro, vmacro, log g curves; [Fe/H] +0.08; CNO) with the phase-1 bundle.
[ -d $P1 ] || { echo "phase-1 bundle missing: $P1"; exit 1; }
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --bundle $P1 --out $OUTD/dcep_lit_luck_lg_p1.pkl
