#!/bin/bash
#PBS -N ai-lit3-tz-gal
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# TZ For exact forward model with the phase-3 emulator, two parameter sets, same (current) fit script:
#  base     = the literature run so far: Teff 4930 / 6350 (Gallenne 2016 adopted), [Fe/H] -0.30 both (OUR earlier fitted value, NOT a literature value: Andersen 1991 give +0.1 +- 0.15),
#             vmicro 1.5 / 1.5 (assumed), v sin i from the meshes (~5.5 / 38)
#  gallenne = full Gallenne et al. 2016 (Table 2 + Sect. 2.1): [Fe/H] +0.02 / -0.05, vt 0.98 / 3.10 km/s,
#             v sin i 6.1 / 45.7 km/s; Teff 4930 / 6350 (adopted, H-band flux ratio), log g 2.91 / 3.35, geometry as before
# Not in the literature, unchanged: vmacro 5 / 6, primary C/N/O 0, beta 0.079.
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit.py
TZ_BASE=${TZ_ARGS%--set*}            # every argument except the --set start values
# smoke with the Gallenne options (1 spectroscopic, 3 light-curve epochs); stop if it fails
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_BASE --set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 \
    --feh-secondary -0.05 --vmicro 0.98 3.10 --vsini 6.1 45.7 --n-epochs 1 --n-lc-epochs 3 \
    --out $OUTD/tzfor_lit_exact_p3_gallenne_smoke.pkl || { echo "GALLENNE SMOKE FAIL"; exit 1; }
echo "GALLENNE SMOKE PASS"
rc=0
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_BASE --set Teff1=4930 Teff2=6350 feh=-0.30 dphi=0 \
    --out $OUTD/tzfor_lit_exact_p3_base.pkl --dump-model $OUTD/tzfor_lit_exact_p3_base.npz || rc=1
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_BASE --set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 \
    --feh-secondary -0.05 --vmicro 0.98 3.10 --vsini 6.1 45.7 \
    --out $OUTD/tzfor_lit_exact_p3_gallenne.pkl --dump-model $OUTD/tzfor_lit_exact_p3_gallenne.npz || rc=1
exit $rc
