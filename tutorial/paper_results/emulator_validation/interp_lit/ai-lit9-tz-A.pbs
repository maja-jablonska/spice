#!/bin/bash
#PBS -N ai-lit9-tz-A
#PBS -P y89
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# TZ For literature models (Gallenne et al. 2016), phase 3, no mask, exact per-element dumps, revised photometric treatment:
#   - photometric-ephemeris offset dphi = -0.00044 cycles (-0.8 h; the same in SPICE and PHOEBE, from tzfor_phot_rescore.py),
#   - NO nightly zero points (--phot-nightly-sigma 0; they had absorbed the ingress/egress timing misfit),
#   - each star at its own systemic velocity (Gallenne gamma1 17.99, gamma2 18.35; --gamma-components).
# vmac0 = the literal model (their v sin i come from broadening functions, which include macroturbulence); vmac = 5/6 km/s.
# V100 is fine (conv_valid broadening). Smoke first. No PBS commands inside.
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit.py
TZ_BASE=${TZ_ARGS%--set*}
TZ_NM=$(echo "$TZ_BASE" | sed "s/--mask-in [^ ]*//")
[ "$TZ_NM" != "$TZ_BASE" ] || { echo "mask flag not found in TZ_ARGS"; exit 1; }
NEW="--gamma-components --phot-nightly-sigma 0"
GAL="--set Teff1=4930 Teff2=6350 feh=0.02 dphi=-0.00044 --feh-secondary -0.05 --vmicro 0.98 3.10 --vsini 6.1 45.7 $NEW"
GALM="--set Teff1=4930 Teff2=6350 feh=-0.18 dphi=-0.00044 --feh-secondary -0.25 --vmicro 0.98 3.10 --vsini 6.1 45.7 $NEW"
GSP="--set Teff1=4930 Teff2=6650 feh=0.02 dphi=-0.00044 --feh-secondary -0.05 --vmicro 0.98 3.10 --vsini 6.1 45.7 $NEW"
V0="--vmacro0 0 0"
run() { SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM "${@:2}" --out $OUTD/tzfor_lit2_p3_$1.pkl --dump-model $OUTD/tzfor_lit2_p3_$1.npz; }
nvidia-smi -L
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM $GAL $V0 --n-epochs 1 --n-lc-epochs 3 --out $OUTD/tzfor_lit2_smoke_$PBS_JOBID.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
rc=0
run lit $GAL $V0 || rc=1
run vmac $GAL || rc=1
run spec_lit $GSP $V0 || rc=1
exit $rc
