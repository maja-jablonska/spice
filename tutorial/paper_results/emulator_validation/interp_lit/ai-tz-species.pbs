#!/bin/bash
#PBS -N ai-tz-species
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=2
#PBS -l mem=32GB
#PBS -l walltime=00:40:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# TZ For [Fe/H] zero-point: misfit by line class (Fe I, Fe II, other neutral / ionised, blends, continuum), with and without a
# free continuum level per 25 A block, for the six unmasked literature models. CPU; no PBS commands.
set -uo pipefail
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; I=/scratch/y89/mj8805/litrepro/interp; O=$I/out
$PY -u $I/tzfor_species_compare.py /scratch/mk27/mj8805/Turbospectrum_NLTE/input_files/linelists/nlte_ges_linelist_jmg16jan2026_I_II \
    $O/tzfor_lit_nomask_p3_{fitted,gallenne,gallenne_vmac0,gallenne_fehm02,gallenne_fehm02_vmac0,gallenne_spec_vmac0}.npz
