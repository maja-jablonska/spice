#!/bin/bash
#PBS -N ai-fit-tz-gp
#PBS -P y89
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=40:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
# TZ For full fit, phase 3, no mask, vt1 free, with the noise fitted as part of the model:
#   spectra: Starfish-like correlated-noise GP per epoch (tzfor_gp_noise.BlockGP; Matern-3/2 amplitude per epoch + shared
#   length, plus a shared long kernel for the ~2 A residual tail; 1024-px blocks), -2 ln L in the loss;
#   photometry: one error scale per band (b, y).
# Otherwise as ai-fit-tz-w.pbs (Gallenne start, v sin i 6.1/45.7, vt2 3.10). V100 is fine: broadening is conv_valid
# (no cuDNN). tzfor_fullrange_fit_gp.py = the repo's tzfor_fullrange_fit.py with --gp-noise (deployed under its own name
# so the running weight-scan jobs keep their file). Smoke first. No PBS commands.
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit_gp.py
TZ_BASE=${TZ_ARGS%--set*}
TZ_NM=$(echo "$TZ_BASE" | sed "s/--mask-in [^ ]*//")
[ "$TZ_NM" != "$TZ_BASE" ] || { echo "mask flag not found in TZ_ARGS"; exit 1; }
FIT="$TZ_NM --set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 --feh-secondary -0.05 --free-feh-secondary --free-vmacro --free-cno \
     --vmicro 0.98 3.10 --free-vmicro --vsini 6.1 45.7 --gp-noise --gp-long --gp-block 1024 --phot-noise-scale"
nvidia-smi -L
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $FIT --maxiter 2 --stall-retries 0 --n-epochs 2 --n-lc-epochs 4 --out $OUTD/tzfor_fit_p3_gp_smoke.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $FIT --maxiter 120 --stall-retries 1 --out $OUTD/tzfor_fit_p3_gp.pkl --dump-model $OUTD/tzfor_fit_p3_gp.npz
