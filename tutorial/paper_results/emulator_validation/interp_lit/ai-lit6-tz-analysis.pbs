#!/bin/bash
#PBS -N ai-lit6-tz-an
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=2
#PBS -l mem=24GB
#PBS -l walltime=00:40:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Unmasked TZ For literature models: chi2 decomposition (fitted vs each Gallenne variant) and Fe I-only comparison. CPU, no PBS commands.
set -uo pipefail
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; I=/scratch/y89/mj8805/litrepro/interp; O=$I/out
for g in gallenne gallenne_vmac0 gallenne_spec_vmac0; do
  $PY -u $I/tzgal_decompose.py $O $g tzfor_lit_nomask_p3_fitted tzfor_lit_nomask_p3_
done
$PY -u $I/tzfor_fe1_compare.py /scratch/mk27/mj8805/Turbospectrum_NLTE/input_files/linelists/nlte_ges_linelist_jmg16jan2026_I_II \
    $O/tzfor_lit_nomask_p3_fitted.npz $O/tzfor_lit_nomask_p3_{fitted,gallenne,gallenne_vmac0,gallenne_spec_vmac0}.npz
