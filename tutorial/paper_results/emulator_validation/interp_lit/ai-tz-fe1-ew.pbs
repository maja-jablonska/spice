#!/bin/bash
#PBS -N ai-tz-fe1-ew
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=2
#PBS -l mem=24GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# TZ For [Fe/H] from Fe I equivalent widths (Gallenne's method) with our models: Gallenne +0.02 vs the same at -0.18,
# vmacro 5/6 and 0. CPU; no PBS commands.
set -uo pipefail
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; I=/scratch/y89/mj8805/litrepro/interp; O=$I/out
$PY -u $I/tzfor_fe1_ew.py /scratch/mk27/mj8805/Turbospectrum_NLTE/input_files/linelists/nlte_ges_linelist_jmg16jan2026_I_II \
    $O/tzfor_lit_nomask_p3_gallenne.npz $O/tzfor_lit_nomask_p3_gallenne_fehm02.npz 0.02 -0.18 \
    $O/tzfor_lit_nomask_p3_gallenne_vmac0.npz $O/tzfor_lit_nomask_p3_gallenne_fehm02_vmac0.npz
