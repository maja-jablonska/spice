#!/bin/bash
#PBS -N ai-lit8-tz-ew
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=2
#PBS -l mem=32GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# TZ For Fe I EW abundances over the primary microturbulence scan (vt 0.98 / 1.3 / 1.6 / 2.0), strict + broad selections,
# default + relaxed cuts, cut diagnostics, microturbulence balance, per-line tables and a plot. CPU; no PBS commands.
set -uo pipefail
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; I=/scratch/y89/mj8805/litrepro/interp; O=$I/out; mkdir -p $O/fe1_ew
N=$O/tzfor_lit_nomask_p3
$PY -u $I/tzfor_fe1_ew.py /scratch/mk27/mj8805/Turbospectrum_NLTE/input_files/linelists/nlte_ges_linelist_jmg16jan2026_I_II $O/fe1_ew/tzfor_fe1 \
    vt098:0.98:${N}_gallenne.npz:${N}_gallenne_fehm02.npz:0.02:-0.18 \
    vt13:1.3:${N}_gallenne_vt13.npz:${N}_gallenne_vt13_fehm02.npz:0.02:-0.18 \
    vt16:1.6:${N}_gallenne_vt16.npz:${N}_gallenne_vt16_fehm02.npz:0.02:-0.18 \
    vt20:2.0:${N}_gallenne_vt20.npz:${N}_gallenne_vt20_fehm02.npz:0.02:-0.18
