#!/bin/bash
#PBS -N ai-lit8-tz-vt20
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# TZ For Gallenne 2016 model with the PRIMARY's microturbulence at 2.0 km/s (Gallenne: 0.98; secondary 3.10 kept), [Fe/H]
# +0.02 / -0.05 and the same shifted by -0.2: the pair gives Fe I equivalent-width abundances at this vt (tzfor_fe1_ew.py),
# for Gallenne's microturbulence balance. NO residual mask, vmacro 5/6. Smoke first. No PBS commands inside.
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit.py
TZ_BASE=${TZ_ARGS%--set*}
TZ_NM=$(echo "$TZ_BASE" | sed "s/--mask-in [^ ]*//")
[ "$TZ_NM" != "$TZ_BASE" ] || { echo "mask flag not found in TZ_ARGS"; exit 1; }
GA="--set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 --feh-secondary -0.05 --vmicro 2.0 3.10 --vsini 6.1 45.7"
GB="--set Teff1=4930 Teff2=6350 feh=-0.18 dphi=0 --feh-secondary -0.25 --vmicro 2.0 3.10 --vsini 6.1 45.7"
run() { SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM "${@:2}" --out $OUTD/tzfor_lit_nomask_p3_$1.pkl --dump-model $OUTD/tzfor_lit_nomask_p3_$1.npz; }
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM $GA --n-epochs 1 --n-lc-epochs 3 --out $OUTD/tzfor_lit_nomask_smoke_vt20.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
rc=0
run gallenne_vt20 $GA || rc=1
run gallenne_vt20_fehm02 $GB || rc=1
exit $rc
