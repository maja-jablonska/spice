#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=01:30:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-dcep-xfit-smoke
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# delta Cep EXACT-synthesis fit with the phase-1 interpolated-atmosphere bundle, started from the full Luck (2018) model:
# Teff(phase) (free, starting at Luck), log g / vmicro (uncapped) / vmacro curves, [Fe/H] +0.08, CNO; free E(B-V), vmacro,
# vrot scale. Same setup as the v2b fit dc_fit_luck_lg (181888860) except: bundle, Luck Teff start, no --init-from, no marcs/cap.
[ -d $P1 ] || { echo "phase-1 bundle missing: $P1"; exit 1; }
LUCK=/scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY --fits /scratch/y89/mj8805/dcep_v2b/delta_cep.fits --harpsn /scratch/y89/mj8805/dcep_v2b/harpsn_windows_log.npz --bands VT --ebv0 0.092 --distance-kpc 0.2795 --fix-dphi --dv-mode season --zp-mode zero-mean --spec-floor 0.02 --no-hessian --feh 0.08 --cno0 -0.13 0.35 0.01 --vrot 3 --vmicro-curve $LUCK --vmacro-curve $LUCK --vmacro-order 2 --logg-curve $LUCK --teff-curve $LUCK --exact-loss --free-vrot-scale --skip-validation --gpus 1 --exact-phot-wl 2000 --n-spec-epochs 3 --windows 5160 --n-phases 6 --maxiter 1 --bundle $P1 --out $OUTD/dcep_xfit_luck_full_p1_smoke.pkl || exit 1
