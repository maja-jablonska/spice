#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=36:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
# TZ For full fit, phase 3, no mask, PRIMARY MICROTURBULENCE FREE (vt1, start Gallenne 0.98), with a photometry / spectroscopy
# weight: loss = chi2_phot + SCALE * chi2_spec. qsub -v TAG=..,SCALE=<number|acf>,GEO=<0|1>.
#   SCALE=acf reads out/tz_spec_scale.txt (= chi2nu_phot / (chi2nu_spec * L), written by ai-tz-acf.pbs).
#   GEO=1 also frees R1, R2, inclination (SPICE's own binary inside the loss).
# Otherwise as ai-fit-tz-p3.pbs: free Teff1/2, [Fe/H] 1/2, vmacro1/2, primary C/N/O, dphi; v sin i 6.1/45.7 and vt2 3.10
# fixed (Gallenne+2016). Smoke first. No PBS commands.
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
: "${TAG:?}" "${SCALE:?}" "${GEO:=0}"
if [ "$SCALE" = acf ]; then SCALE=$(cat $OUTD/tz_spec_scale.txt) || { echo "no tz_spec_scale.txt"; exit 1; }; fi
echo "TAG $TAG  spec_scale $SCALE  free geometry $GEO"
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit.py
TZ_BASE=${TZ_ARGS%--set*}
TZ_NM=$(echo "$TZ_BASE" | sed "s/--mask-in [^ ]*//")
[ "$TZ_NM" != "$TZ_BASE" ] || { echo "mask flag not found in TZ_ARGS"; exit 1; }
G=""; [ "$GEO" = 1 ] && G="--free-geometry"
FIT="$TZ_NM --set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 --feh-secondary -0.05 --free-feh-secondary --free-vmacro --free-cno \
     --vmicro 0.98 3.10 --free-vmicro --vsini 6.1 45.7 --spec-scale $SCALE $G"
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $FIT --maxiter 1 --stall-retries 0 --n-epochs 2 --n-lc-epochs 4 --out $OUTD/tzfor_fit_p3_${TAG}_smoke.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $FIT --maxiter 80 --stall-retries 1 --out $OUTD/tzfor_fit_p3_${TAG}.pkl --dump-model $OUTD/tzfor_fit_p3_${TAG}.npz
