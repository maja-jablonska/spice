#!/bin/bash
#PBS -N ai-fitphot2
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Photometry of the vt-free weight-scan and GP fits rescored like the literature models (dphi fitted, no / out-of-eclipse
# nightly zero points). CPU only; no PBS commands.
set -uo pipefail
O=/scratch/y89/mj8805/litrepro/interp/out; PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; CSV=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_lightcurve.csv
for m in vtw1 vtw10 vtw30 vtw100 vtwL gp; do for n in none out-of-eclipse; do
  [ -f $O/tzfor_fit_p3_$m.npz ] && $PY -u /scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py --dump $O/tzfor_fit_p3_$m.npz --csv $CSV --nightly $n
done; done | tee $O/tzfor_fits_vt_phot.txt
