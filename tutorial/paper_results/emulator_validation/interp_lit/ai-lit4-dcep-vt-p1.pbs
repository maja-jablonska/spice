#!/bin/bash
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=09:00:00
#PBS -l storage=scratch/y89+gdata/y89
#PBS -l wd
#PBS -N ai-lit4-vt-p1
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# delta Cep Luck literature models with Tycho VT photometry only (the one band fully inside 3780-6910 A), p1 bundle:
# default Teff curve and Luck Teff curve, E(B-V) fixed at 0.075 (DC_ARGS). Short VT-only smoke first; stop if it fails.
[ -d $P1 ] || { echo "bundle missing: $P1"; exit 1; }
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --bundle $P1 --n-spec-epochs 3 --windows 5160 6700 --n-phases 6 --out $OUTD/dc_vt_smoke_p1.pkl || { echo "VT SMOKE FAIL"; exit 1; }
echo "VT SMOKE PASS"
rc=0
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --bundle $P1 --out $OUTD/dcep_lit_luck_lg_fullvt_vt_p1.pkl || rc=1
SPICE_HARPS_BUNDLE=$P1 $PY -u $DC_PY $DC_ARGS --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt --bundle $P1 --out $OUTD/dcep_lit_luck_lgT_fullvt_vt_p1.pkl || rc=1
exit $rc
