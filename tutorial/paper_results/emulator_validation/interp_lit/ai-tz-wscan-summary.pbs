#!/bin/bash
#PBS -N ai-tz-wsum
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Collects the weight-scan fits' final lines (fitted parameters, exact chi2) into out/tz_wscan_summary.txt. No PBS commands.
set -uo pipefail
I=/scratch/y89/mj8805/litrepro/interp; S=$I/out/tz_wscan_summary.txt
{ cat $I/out/tz_acf.log 2>/dev/null | grep -E "L_pixels|chi2nu|spec_scale|L per epoch"
  for t in vtw1 vtw10 vtw30 vtw100 vtwL vtwLgeo; do
    f=$(ls -t $I/ai-fit-tz-$t.o* 2>/dev/null | head -1); echo "=== $t ($f)"
    [ -n "$f" ] || continue
    grep -E "^TAG|SMOKE|^pass|^exact model|Error|Traceback" "$f" | grep -v "1 it, 3 eval"
  done; } > $S
cat $S
