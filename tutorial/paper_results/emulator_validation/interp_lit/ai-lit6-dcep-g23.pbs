#!/bin/bash
#PBS -N ai-lit6-dcep-g23
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=09:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
# delta Cep Luck literature models, VT only, phase 3, corrected: vrot 0 (Luck: all broadening in Vb), Vb curve Fourier order 4,
# Gordon et al. 2023 extinction (all via DC_ARGS); Trahin 2021 Teff curve and Luck Teff curve; E(B-V) 0.092, d 279.5 pc.
# Short smoke first. No PBS commands inside.
[ -d $P3 ] || { echo "bundle missing: $P3"; exit 1; }
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_ARGS --bundle $P3 --n-spec-epochs 3 --windows 5160 6700 --n-phases 6 --out $OUTD/dc_vt_g23_smoke_p3.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
rc=0
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_ARGS --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_trahin2021_teff_curve.txt --bundle $P3 --out $OUTD/dcep_lit_luck_lgTtrahin_vt_g23_vrot0_p3.pkl || rc=1
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_ARGS --teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt --bundle $P3 --out $OUTD/dcep_lit_luck_lgT_vt_g23_vrot0_p3.pkl || rc=1
exit $rc
