#!/bin/bash
#PBS -N tz-port
#PBS -P y89
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
# The PHOEBE literature model of TZ For ported to SPICE: PHOEBE's meshes AND per-element Teff maps (step q1; --mesh-teff),
# SPICE's emulator intensities, exact per-element synthesis. Otherwise the pure literature setup: Gallenne et al. 2016
# [Fe/H], vt, v sin i, gamma1/gamma2, no macroturbulence; Andersen et al. 1991 ephemeris; no nightly zero points; no
# continuum correction (reference run with it). Nothing fitted. Smoke first. No PBS commands.
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
G=/scratch/y89/mj8805/litrepro/pure
TZ_PY=/scratch/y89/mj8805/exactfit/tzfor/tzfor_fullrange_fit.py
TZ_BASE=${TZ_ARGS%--set*}
TZ_NM=$(echo "$TZ_BASE" | sed "s/--mask-in [^ ]*//")
[ "$TZ_NM" != "$TZ_BASE" ] || { echo "mask flag not found in TZ_ARGS"; exit 1; }
PORT="--set Teff1=4930 Teff2=6350 feh=0.02 dphi=0 --feh-secondary -0.05 --vmicro 0.98 3.10 --vsini 6.1 45.7 --vmacro0 0 0 \
      --gamma-components --dv-sys 0 --phot-nightly-sigma 0 --phot-ephemeris 2445032.6091 75.66675 --mesh-teff \
      --spec-meshes $G/tzfor_phoebe_lit_n1500_spectra_meshes.pkl --lc-meshes $G/tzfor_phoebe_lit_n1200_lc_meshes.pkl"
run() { SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM "${@:2}" --out $OUTD/tzfor_port_p3_$1.pkl --dump-model $OUTD/tzfor_port_p3_$1.npz; }
nvidia-smi -L
SPICE_HARPS_BUNDLE=$P3 $PY -u $TZ_PY $TZ_NM $PORT --no-continuum-fix --n-epochs 1 --n-lc-epochs 3 --out $OUTD/tzfor_port_smoke_$PBS_JOBID.pkl --dump-model $OUTD/tzfor_port_smoke_$PBS_JOBID.npz || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
rc=0
run port $PORT --no-continuum-fix || rc=1
run port_cont $PORT || rc=1
exit $rc
