#!/bin/bash
#PBS -N tz-pure-mesh
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# TZ For SPICE meshes at the light-curve geometry of Gallenne et al. 2016 (their WD model: Andersen et al. 1991 fractional
# radii x their semi-major axis -> R1 8.34, R2 3.97 Rsun; i 85.68 deg) with the secondary rotating at
# v sin i / sin i = 45.83 km/s (their WD model includes its ~1.2% flattening). Nothing fitted. Spectra meshes at the
# 21 HARPS epochs (n1500), light-curve meshes 40 phases per eclipse (n1200). CPU only; no PBS commands.
set -uo pipefail
export PHOEBE_ENABLE_ONLINE_PASSBANDS=FALSE OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 JAX_PLATFORMS=cpu
export PYTHONPATH=/scratch/y89/mj8805/spice_v2/src
export TZ_FOR_PRIMARY_RADIUS=8.34 TZ_FOR_SECONDARY_RADIUS=3.97 TZ_FOR_INCL_DEG=85.68 TZ_FOR_SECONDARY_VROT_KMS=45.83
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; G=/scratch/y89/mj8805/litrepro/pure; T=/scratch/y89/mj8805/litrepro/tzfor
OLD_SP=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_aemu_roche_n1500_spectra_meshes.pkl; OLD_LC=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_aemu_roche_n1200_lc6650_meshes.pkl
cd $T
$PY -u tzfor_phoebe_aemu_photometry.py --mode export-spectra --n-mesh 1500 --names-from $OLD_SP --times-from $OLD_SP \
    --meshes $G/tzfor_gallenne_lcgeom_n1500_spectra_meshes.pkl || exit 1
$PY -u tzfor_phoebe_aemu_photometry.py --mode export-lc --n-mesh 1200 --teff2 6350 --n-per-eclipse 40 --n-out 12 --names-from $OLD_LC \
    --meshes $G/tzfor_gallenne_lcgeom_n1200_lc_meshes.pkl || exit 1
ls -la $G/*.pkl
