#!/bin/bash
#PBS -N dcep-pure-A
#PBS -P dg97
#PBS -q gpursaa
#PBS -l ncpus=14
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/y89+scratch/y89+scratch/mk27
#PBS -j oe
#PBS -m ae
# delta Cep, pure literature forward model: nothing adjusted to the data. DC_ARGS (VT only, no zero point; SPIPS radius curve
# at Trahin's 279.5 pc; E(B-V) 0.092; G23; Luck log g, vt, broadening (R 60000 instrument removed), [Fe/H], CNO; no rotation),
# HARPS-N 2015 season only (Nardetto et al. 2017; the 2019 archive spectra sit 3.3 km/s off the published orbit), systemic
# velocity from the Anderson et al. 2015 orbit at the 2015 epochs (-17.11 km/s; no CCF), no continuum correction.
# Reference (A): Trahin with the per-window linear continuum correction. Smoke first. No PBS commands.
set -uo pipefail
source /scratch/y89/mj8805/litrepro/interp/lit_common.sh
[ -d $P3 ] || { echo "bundle missing: $P3"; exit 1; }
PURE="--season 2015 --dv-sys -17.111 --vmacro-instr-r 60000"
TRAHIN="--teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_trahin2021_teff_curve.txt"
LUCK="--teff-curve /scratch/y89/mj8805/exactfit/dcep/literature/dcep_luck2018_table6.txt"
run() { SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_ARGS $PURE "${@:2}" --bundle $P3 --out $OUTD/dcep_pure_$1_p3.pkl; }
SPICE_HARPS_BUNDLE=$P3 $PY -u $DC_PY $DC_ARGS $PURE --no-continuum-fix --bundle $P3 --n-spec-epochs 3 --windows 5160 6700 --n-phases 6 --out $OUTD/dc_pure_smoke_$PBS_JOBID.pkl || { echo "SMOKE FAIL"; exit 1; }
echo "SMOKE PASS"
rc=0
run trahin_pure $TRAHIN --no-continuum-fix || rc=1
run trahin_cont $TRAHIN || rc=1
exit $rc
