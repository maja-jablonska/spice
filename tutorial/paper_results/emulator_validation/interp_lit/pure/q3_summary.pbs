#!/bin/bash
#PBS -N tz-port-sum
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Summary: the PHOEBE literature model ported to SPICE, scored with Andersen's ephemeris and no nightly zero points; PHOEBE's
# own light curve for the same setup (lcR runs). CPU only; no PBS commands.
set -uo pipefail
G=/scratch/y89/mj8805/litrepro/pure; O=/scratch/y89/mj8805/litrepro/interp/out; PH=/scratch/y89/mj8805/litrepro/phoebe/out
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python; CSV=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_lightcurve.csv
R=/scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py
{ grep -h "constants:\|irradiation changes\|teff .*spread\|teff  *[0-9]" $(ls -t $G/tz-port-mesh.o* | head -1)
  for f in $(ls -t $G/tz-port.o* 2>/dev/null | head -1); do grep -E "SMOKE|--mesh-teff|photometry phased|^exact model" $f; done
  for m in port port_cont; do [ -f $O/tzfor_port_p3_$m.npz ] && $PY -u $R --dump $O/tzfor_port_p3_$m.npz --csv $CSV --ephemeris 2445032.6091 75.66675 --dphi 0 --nightly none; done
  echo "=== PHOEBE, same setup (lcR = R 8.34/3.97, i 85.68, vrot 6.12/45.83, horvat), Andersen ephemeris offset"
  $PY -u $R --dump $O/tzfor_lit_nomask_p3_gallenne.npz --csv $CSV --dphi -0.00046 --nightly none --phoebe $PH/phoebe_gallenne_lcR.npz $PH/phoebe_gallenne_lcR_ph.npz $PH/phoebe_gallenne_lcR_noirr.npz
} > $G/port_summary.txt 2>&1
cat $G/port_summary.txt
