#!/bin/bash
#PBS -N ai-lit9-sum
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -j oe
# Summary of the lit9 literature models: TZ For exact chi2 lines + photometry rescored with a fitted dphi and no nightly
# zero points (SPICE vs PHOEBE), delta Cep chi2 lines + V_T level. CPU only; no PBS commands.
set -uo pipefail
I=/scratch/y89/mj8805/litrepro/interp; O=$I/out; PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python
export PYTHONPATH=/scratch/y89/mj8805/spice_v2/src
CSV=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_lightcurve.csv; PH=/scratch/y89/mj8805/litrepro/phoebe/out
{
echo "=== TZ For exact models"; for f in $(ls -t $I/ai-lit9-tz-*.o* 2>/dev/null); do grep -E "per-star systemic|^exact model|model dump|SMOKE" $f; done
for m in lit vmac spec_lit feh_lit feh_vmac; do
  [ -f $O/tzfor_lit2_p3_$m.npz ] || { echo "missing $m"; continue; }
  P=""; case $m in spec_lit) P="$PH/phoebe_gallenne_spec_ck2004_horvat.npz $PH/phoebe_gallenne_spec_phoenix_horvat.npz";; lit|vmac) P="$PH/phoebe_gallenne_ck2004_horvat.npz $PH/phoebe_gallenne_phoenix_horvat.npz $PH/phoebe_gallenne_ck2004_none.npz";; esac
  for n in none out-of-eclipse; do $PY -u /scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py --dump $O/tzfor_lit2_p3_$m.npz --csv $CSV --nightly $n --phoebe $P --json $O/tzfor_lit2_p3_${m}_phot_$n.json; done
done
echo "=== TZ For free fit (ai-fit-tz-p3), rescored"; for n in none out-of-eclipse; do $PY -u /scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py --dump $O/tzfor_fit_p3_nomask.npz --csv $CSV --nightly $n --json $O/tzfor_fit_p3_nomask_phot_$n.json; done
echo "=== delta Cep"; for f in $(ls -t $I/ai-lit9-dcep-*.o* 2>/dev/null); do tr "\r" "\n" < $f | grep -E "^Teff\(phase\)|vmacro curve: removing|exact-all spectra|exact-all photometry|  end:|residual dv vs model|SMOKE"; done
$PY -u $I/dcep_vt_level.py $O/dcep_lit9_*_p3.pkl
} > $O/lit9_summary.txt 2>&1
cat $O/lit9_summary.txt
