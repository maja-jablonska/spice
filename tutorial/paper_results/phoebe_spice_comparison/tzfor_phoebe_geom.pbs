#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=6
#PBS -l mem=40GB
#PBS -l walltime=08:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89
#PBS -l wd
#PBS -N tz-phoebe-geom
#PBS -j oe
#PBS -m ae
# TZ For geometry tests with PHOEBE at Gallenne 2016 parameters, scored with the revised photometric treatment
# (fitted photometric-ephemeris offset, no nightly zero points; tz_fornacis/tzfor_phot_rescore.py):
#   lcR      Gallenne's light-curve radii 8.34 / 3.97 (Andersen's fractional radii x their a; the WD model behind 6350 K)
#   lcR_ph   the same with phoenix atmospheres
#   lcR_noirr  the same, ck2004, no irradiation
#   v38      secondary rotating at 38 km/s (the SPICE meshes' rotation: less Roche flattening than 45.8)
#   n6000    6000 triangles (mesh-resolution check; default 3000)
# CPU only; no PBS commands inside.
set -uo pipefail
export PHOEBE_ENABLE_ONLINE_PASSBANDS=FALSE OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 JAX_PLATFORMS=cpu
export PYTHONPATH=/scratch/y89/mj8805/spice_v2/src TZFOR_DIR=/scratch/y89/mj8805/litrepro/tzfor
PY=/g/data/y89/mj8805/miniforge/envs/phoebe/bin/python
D=/scratch/y89/mj8805/litrepro/phoebe; S=$D/tzfor_phoebe_literature_lc.py; O=$D/out
DUMP=/scratch/y89/mj8805/litrepro/interp/out/tzfor_lit_nomask_p3_gallenne.npz; CSV=/scratch/y89/mj8805/tzfor_v2b/run/tzfor_lightcurve.csv
run() { local tag=$1; shift; $PY -u $S --dump $DUMP --params gallenne --photometry $CSV --out $O/phoebe_gallenne_$tag.npz "$@" > $O/phoebe_gallenne_$tag.log 2>&1; }
pids=()
run lcR --atm ck2004 --irrad horvat --requiv 8.34 3.97 & pids+=($!)
run lcR_ph --atm phoenix --irrad horvat --requiv 8.34 3.97 & pids+=($!)
run lcR_noirr --atm ck2004 --irrad none --requiv 8.34 3.97 & pids+=($!)
run v38 --atm ck2004 --irrad horvat --vrot 5.55 38.0 & pids+=($!)
run n6000 --atm ck2004 --irrad horvat --n-mesh 6000 & pids+=($!)
rc=0; for pid in "${pids[@]}"; do wait $pid || rc=1; done
grep -h "^RESULT\|Traceback\|Error" $O/phoebe_gallenne_{lcR,lcR_ph,lcR_noirr,v38,n6000}.log
F=""; for t in ck2004_horvat phoenix_horvat ck2004_none lcR lcR_ph lcR_noirr v38 n6000; do [ -f $O/phoebe_gallenne_$t.npz ] && F="$F $O/phoebe_gallenne_$t.npz"; done
$PY -u /scratch/y89/mj8805/exactfit/tzfor/tzfor_phot_rescore.py --dump $DUMP --csv $CSV --nightly none --phoebe $F --json $O/phoebe_geom_rescore.json | tee $O/phoebe_geom_rescore.txt
exit $rc
